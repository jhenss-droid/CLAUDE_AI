# Copy to .env and fill in PAPER-trading keys from https://app.alpaca.markets/paper/dashboard/overview
# Never commit .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

BOT_SYMBOLS=SPY,AAPL,MSFT
BOT_FAST_WINDOW=10
BOT_SLOW_WINDOW=30
BOT_MAX_POSITION_PCT=0.05
BOT_MAX_DAILY_LOSS_PCT=0.02
BOT_MAX_ORDERS_PER_RUN=3
BOT_DRY_RUN=true

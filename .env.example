# Alpaca PAPER-trading keys, from https://app.alpaca.markets/paper/dashboard/overview
# (the Key ID starts with PK). Never commit or share the real file.
#
# Where to save the real file, per computer (first one found wins):
#   Recommended - stays on this computer only, not synced to Google Drive:
#     Windows:      C:\Users\<you>\.alpaca_bot.env
#     macOS/Linux:  ~/.alpaca_bot.env
#   Or - synced to every computer, but also stored in your Google Drive:
#     .env  in this project folder
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
